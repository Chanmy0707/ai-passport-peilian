# peilian 服务端配置模板：复制为 .env 后填写（.env 不入库）
# ===== MiMo 模型（你来填 MIMO_API_KEY）=====
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_LLM_MODEL=mimo-v2.6-flash
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=

# ===== 服务端 =====
# 后台管理员令牌（MVP 单账号，请求头 X-Admin-Token）
ADMIN_TOKEN=admin-dev-token
# 管理端登录账号（MVP 单账号，登录成功后下发 ADMIN_TOKEN）
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=qwe@123456
# 设备预共享令牌（烧录进固件，设计文档 §5.2；请求头 X-Device-Token / hello.token）
DEVICE_TOKEN=device-dev-token
# 音频存储目录与数据库路径（相对 server/ 运行目录）
AUDIO_DIR=audio
DB_PATH=peilian.db
# 陪练对话引擎 mock 开关（1=不联网假模型，冒烟/无网联调用）
PRACTICE_MOCK_MODELS=0
